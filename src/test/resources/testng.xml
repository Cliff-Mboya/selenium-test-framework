<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Selenium Parallel Suite" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="UI Parallel Tests">
        <classes>
            <class name="tests.LoginBusinessFlowTest"/>
            <class name="tests.ProductsPageTest"/>
        </classes>
    </test>

</suite>
